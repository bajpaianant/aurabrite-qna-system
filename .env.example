# =========================================================
# AuraBrite QnA — Environment configuration
# Copy to `.env` and edit. All values are OPTIONAL — the
# system defaults to an offline MOCK LLM provider that is
# fully deterministic for evaluation.
# =========================================================

# --- LLM provider selection ---
# One of: mock | openai | anthropic | litellm
LLM_PROVIDER=mock
LLM_MODEL=mock-supervisor
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# --- Provider credentials (only needed when LLM_PROVIDER != mock) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# LiteLLM works transparently with any of the above.

# --- Web search ---
# Enables the WebResearchAgent tool. Options: duckduckgo | tavily | none
WEB_SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# --- Data / paths ---
AURABRITE_DATA_DIR=./data
AURABRITE_WAREHOUSE_PATH=./data/warehouse/aurabrite.duckdb
AURABRITE_DOCS_DIR=./data/documents
AURABRITE_VECTOR_DIR=./data/warehouse/vector_index

# --- Runtime knobs ---
AURABRITE_MAX_AGENT_STEPS=8
AURABRITE_VALIDATION_ROUNDS=2
AURABRITE_LOG_LEVEL=INFO
