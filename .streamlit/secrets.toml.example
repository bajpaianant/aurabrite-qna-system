# Copy this to `secrets.toml` for LOCAL testing only. On Streamlit Community
# Cloud, paste the same content into the app's "Secrets" panel
# (Settings → Secrets). All keys are OPTIONAL — the app runs fully with the
# deterministic offline mock LLM when nothing is set.

LLM_PROVIDER = "mock"
LLM_MODEL = "mock-supervisor"

# --- Only needed if LLM_PROVIDER != mock ---
# OPENAI_API_KEY = "sk-..."
# ANTHROPIC_API_KEY = "sk-ant-..."
# GEMINI_API_KEY = "AIza..."
# LLM_PROVIDER = "openai"      # or "anthropic" / "litellm"
# LLM_MODEL = "gpt-4o-mini"
#
# Google Gemini example (uses LiteLLM under the hood).
# Get an AI Studio API key at https://aistudio.google.com/apikey — it
# starts with `AIza...` (Vertex AI OAuth tokens `AQ.` / `ya29.` do NOT
# work with LiteLLM's `gemini/*` provider).
# LLM_PROVIDER   = "litellm"
# LLM_MODEL      = "gemini/gemini-2.0-flash-exp"   # stable free-tier default
# GEMINI_API_KEY = "AIza..."

# --- Web search ---
WEB_SEARCH_PROVIDER = "duckduckgo"
# TAVILY_API_KEY = "tvly-..."

# --- Runtime knobs ---
AURABRITE_MAX_AGENT_STEPS = "8"
AURABRITE_VALIDATION_ROUNDS = "2"
AURABRITE_LOG_LEVEL = "INFO"
